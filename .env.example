# KalaSetu - Environment Configuration
# Track: Art Beyond Boundaries | ACM x MLH Hackathon

# Official Google Gemini API Key (Get yours from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Public deployment URL for QR code generation (e.g. https://kalasetu.streamlit.app)
# If left blank, QR codes will generate self-contained guide data payloads.
KALASETU_PUBLIC_URL=http://localhost:8501
